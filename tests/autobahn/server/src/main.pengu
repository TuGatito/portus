## Servidor de eco para la suite de Autobahn.
##
## Devuelve cada mensaje tal cual (texto o binario) y cierra cuando el cliente
## cierra. Se arranca con `tests/autobahn.sh`, nunca a mano.

import portus

const PORT as int is 35111

weave echo with data as ref to void, conn as ref to portus.WebSocketConn, opcode as int, payload as ref to frozen byte, length as int into void:
    if opcode == 1:
        let text as string is calling portus.ws_text with payload, length
        let sent as bool is calling conn.send_text with text
        banish text
        return
    if opcode == 2:
        calling conn.send_bytes with payload, length
        return
    if opcode == 8:
        calling conn.close
        return
    return

weave upgrade with context as ref to portus.Context into result of void to portus.HttpError:
    let handler as portus.WebSocketHandler is calling portus.ws_handler with echo, (transmute 0 to ref to void)
    let ok as bool is calling portus.ws_upgrade with context, handler
    if ok:
        return calling portus.ok_void
    return calling portus.err_void with (calling portus.bad_request with "no es websocket")

weave main into int:
    var app as portus.Application is calling portus.new_application
    let r1 as result of void to portus.PatternError is calling portus.get with sigil of app, "/echo", upgrade
    let r2 as result of void to portus.PatternError is calling portus.get with sigil of app, "/", upgrade
    let served as result of int to string is calling portus.serve with sigil of app, PORT
    let bound as int is served or:
        return 1
    return bound
