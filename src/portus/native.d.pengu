## Binding C del transporte HTTP/1.1 de portus.
##
## Declara únicamente lo que `include/portus_native.h` exporta: el bucle de
## `poll(2)`, el parser incremental de llhttp y los accesores que usa el
## dispatcher. Ningún tipo de llhttp cruza esta frontera.
##
## Este módulo solo declara; la lógica vive en `portus.transport`.
include "portus_native.h"

## Petición HTTP en curso. Opaca: solo se manipula con los accesores de abajo.
alias portus_request_t as opaque

## Respuesta HTTP en construcción. Opaca, igual que la petición.
alias portus_response_t as opaque

# --- Utilidades -----------------------------------------------------------

declare portus_native_ping with n as int into int
declare portus_native_last_error into ref to frozen char
declare portus_native_random_hex with out as ref to byte, bytes as int into int
declare portus_native_now_ms into long
declare portus_native_request_id into ref to frozen char
declare portus_native_file_info with path as ref to frozen byte, path_length as int, out_size as ref to long, out_mtime as ref to long into int

# --- Servidor -------------------------------------------------------------

declare portus_native_serve with host as ref to frozen byte, port as int, max_connections as int, max_header_bytes as int, max_body_bytes as int, idle_timeout_ms as int, keep_alive as int, handler as weave with userdata as ref to void, request as ref to void, response as ref to void into void , userdata as ref to void, out_port as ref to int into int

# --- Petición -------------------------------------------------------------

declare portus_native_request_method_name with request as ref to portus_request_t, length as ref to int into ref to frozen char
declare portus_native_request_path with request as ref to portus_request_t, length as ref to int into ref to frozen char
declare portus_native_request_query with request as ref to portus_request_t, length as ref to int into ref to frozen char
declare portus_native_request_body with request as ref to portus_request_t, length as ref to int into ref to frozen char
declare portus_native_request_header_count with request as ref to portus_request_t into int
declare portus_native_request_header_name with request as ref to portus_request_t, index as int, length as ref to int into ref to frozen char
declare portus_native_request_header_value with request as ref to portus_request_t, index as int, length as ref to int into ref to frozen char
declare portus_native_request_keep_alive with request as ref to portus_request_t into int
declare portus_native_request_http_minor with request as ref to portus_request_t into int
declare portus_native_request_is_oversized with request as ref to portus_request_t into int

# --- Respuesta ------------------------------------------------------------

declare portus_native_response_set_status with response as ref to portus_response_t, status as int into void
declare portus_native_response_write_bytes with response as ref to portus_response_t, data as ref to frozen byte, length as int into void
declare portus_native_response_header_bytes with response as ref to portus_response_t, name as ref to frozen byte, name_length as int, value as ref to frozen byte, value_length as int into void
declare portus_native_response_mark_sent with response as ref to portus_response_t into void
declare portus_native_response_body with response as ref to portus_response_t, out_length as ref to int into ref to frozen byte
declare portus_native_response_set_body with response as ref to portus_response_t, data as ref to frozen byte, data_length as int into void
declare portus_native_response_header_value with response as ref to portus_response_t, name as ref to frozen byte, name_length as int, out_length as ref to int into ref to frozen byte
declare portus_native_response_stream_begin with response as ref to portus_response_t, content_type as ref to frozen byte, content_type_length as int into int
declare portus_native_response_stream_write with response as ref to portus_response_t, data as ref to frozen byte, data_length as int into int
declare portus_native_response_stream_end with response as ref to portus_response_t into int
declare portus_native_response_status with response as ref to portus_response_t into int

declare portus_native_session_id into ref to frozen char

declare portus_native_constant_time_eq with a as ref to frozen byte, a_length as int, b as ref to frozen byte, b_length as int into int

# --- WebSocket ------------------------------------------------------------

declare portus_native_ws_upgrade with response as ref to portus_response_t, callback as weave with userdata as ref to void, response as ref to void, opcode as int, payload as ref to frozen byte, length as int into void , userdata as ref to void into int
declare portus_native_ws_send with response as ref to portus_response_t, opcode as int, data as ref to frozen byte, data_length as int into int
declare portus_native_ws_close with response as ref to portus_response_t into int
