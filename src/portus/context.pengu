## portus.context — la petición y la respuesta de un handler.
##
## Es el único objeto que ve un handler. Los strings de la petición pertenecen al
## contexto (no los banishes); lo que construyas para la respuesta sí es tuyo.
##
## ## Ejemplo
## ```pengu
## weave hello with context as ref to portus.Context into result of void to portus.HttpError:
##     calling context.set_header with "Content-Type", "text/plain"
##     calling context.send_text with "hola"
##     return calling portus.ok_void
## ```
##
## ## Memoria
## El despachador crea y libera el contexto; no lo guardes.
import std.json
import std.scrolls
import portus.cookie as cookie_module
import portus.multipart as multipart_module
import portus.query as query_module
import portus.route as route
import portus.transport as transport

## La petición, la respuesta y lo que el despachador capturó de la ruta.
rune Context:
    ## Petición de solo lectura.
    request as ref to transport.Request
    ## Respuesta en construcción.
    response as ref to transport.Response
    ## Parámetros capturados por el patrón.
    params as route.Params
    ## Momento (ms monótonos) en que el despachador empezó la petición.
    started_ms as long

enchanting Context:
    ## Valor de un parámetro de ruta.
    ##
    ## ## Retorno
    ## Copia propia, o `none` si el patrón no lo capturó.
    weave param with name as string into maybe string:
        return calling route.get_param with self->params, name

    ## Método HTTP de la petición (`GET`, `POST`, …).
    weave method into string:
        var request as ref to transport.Request is self->request
        return calling request.method

    ## Ruta pedida, sin query string.
    weave path into string:
        var request as ref to transport.Request is self->request
        return calling request.path

    ## Query string cruda (`a=1&b=2`) o `""`.
    weave query into string:
        var request as ref to transport.Request is self->request
        return calling request.query

    ## Fija una cabecera de la respuesta.
    ##
    ## ## Memoria
    ## `name` y `value` se copian en la respuesta.
    weave set_header with name as string, value as string into void:
        var response as ref to transport.Response is self->response
        calling response.set_header with name, value

    ## Añade la cabecera `Content-Type`.
    weave set_content_type with value as string into void:
        var response as ref to transport.Response is self->response
        calling response.set_header with "Content-Type", value

    ## Responde con un cuerpo y el `Content-Type` indicado.
    ##
    ## ## Memoria
    ## El cuerpo se copia en la respuesta; `content_type` es prestado.
    weave send_body_with_type with content_type as string, body as string into void:
        var response as ref to transport.Response is self->response
        calling response.set_header with "Content-Type", content_type
        calling response.write_text with body
        calling response.mark_sent

    ## Responde con texto y `Content-Type: text/plain; charset=utf-8`.
    ##
    ## ## Memoria
    ## El cuerpo se copia en la respuesta.
    weave send_text with body as string into void:
        var response as ref to transport.Response is self->response
        calling response.set_header with "Content-Type", "text/plain; charset=utf-8"
        calling response.write_text with body
        calling response.mark_sent

    ## Responde con HTML.
    weave send_html with body as string into void:
        var response as ref to transport.Response is self->response
        calling response.set_header with "Content-Type", "text/html; charset=utf-8"
        calling response.write_text with body
        calling response.mark_sent

    ## Fija el código de estado sin enviar cuerpo todavía.
    weave set_status with code as int into void:
        var response as ref to transport.Response is self->response
        calling response.set_status with code

    ## Responde con un código y un cuerpo de texto.
    weave send_status with code as int, body as string into void:
        var response as ref to transport.Response is self->response
        calling response.set_status with code
        calling response.set_header with "Content-Type", "text/plain; charset=utf-8"
        calling response.write_text with body
        calling response.mark_sent

    ## Redirige con 302 y `Location: location`.
    weave redirect with location as string into void:
        var response as ref to transport.Response is self->response
        calling response.set_status with 302
        calling response.set_header with "Location", location
        calling response.write_text with ""
        calling response.mark_sent

    ## Redirección permanente (301).
    weave redirect_permanent with location as string into void:
        var response as ref to transport.Response is self->response
        calling response.set_status with 301
        calling response.set_header with "Location", location
        calling response.write_text with ""
        calling response.mark_sent

    ## Responde 204 sin cuerpo.
    weave no_content into void:
        var response as ref to transport.Response is self->response
        calling response.set_status with 204
        calling response.mark_sent

    ## Responde 304 sin cuerpo.
    weave not_modified into void:
        var response as ref to transport.Response is self->response
        calling response.set_status with 304
        calling response.mark_sent

    ## Código de estado actual de la respuesta.
    weave status_code into int:
        var response as ref to transport.Response is self->response
        return calling response.status

    ## ¿El handler ya respondió?
    ## Abre un flujo SSE (`text/event-stream`).
    weave sse_open into bool:
        var response as ref to transport.Response is self->response
        return calling response.stream_begin with "text/event-stream; charset=utf-8"

    ## Envía un evento SSE (`event: …` + `data: …`).
    weave sse_send with event as string, data as string into bool:
        var response as ref to transport.Response is self->response
        var payload as string is "event: {event}\ndata: {data}\n\n"
        var ok as bool is calling response.stream_write_text with payload
        banish payload
        return ok

    ## Cierra el flujo SSE.
    weave sse_close into bool:
        var response as ref to transport.Response is self->response
        return calling response.stream_end

    ## Empieza una respuesta en streaming con `content_type`.
    weave stream_begin with content_type as string into bool:
        var response as ref to transport.Response is self->response
        return calling response.stream_begin with content_type

    ## Escribe un trozo de texto en streaming.
    weave stream_write with text as string into bool:
        var response as ref to transport.Response is self->response
        return calling response.stream_write_text with text

    ## Cierra el streaming.
    weave stream_end into bool:
        var response as ref to transport.Response is self->response
        return calling response.stream_end

    ## Marca la respuesta como enviada sin escribir cuerpo.
    weave mark_sent into void:
        var response as ref to transport.Response is self->response
        calling response.mark_sent
        return

    weave is_sent into bool:
        var response as ref to transport.Response is self->response
        return calling response.is_sent

    ## Valor de una cabecera de la petición (sin distinguir mayúsculas).
    ##
    ## ## Retorno
    ## Copia propia, o `none` si la cabecera no vino.
    weave header with name as string into maybe string:
        var request as ref to transport.Request is self->request
        var wanted as string is calling scrolls.to_lower with name
        var count as int is calling request.header_count
        var i as int is 0
        while i < count:
            var key as string is calling request.header_name with i
            var key_lower as string is calling scrolls.to_lower with key
            if (calling scrolls.compare with key_lower, wanted) == 0:
                banish key_lower
                banish wanted
                return some (calling request.header_value with i)
            banish key_lower
            set i is i + 1
        banish wanted
        return maybe none

    ## Query string de la petición, ya decodificado.
    ##
    ## ## Memoria
    ## Devuelve un valor propio; libéralo con `portus.query.free_query`.
    weave queries into query_module.Query:
        var request as ref to transport.Request is self->request
        return calling query_module.parse_query with (calling request.query)

    ## Primer valor de un parámetro del query string.
    ##
    ## ## Memoria
    ## Copia propia, o `none` si no vino.
    weave query_param with name as string into maybe string:
        var parsed as query_module.Query is calling self.queries
        var found as maybe string is calling query_module.query_get with parsed, name
        calling query_module.free_query with parsed
        return found

    ## Cuerpo de la petición como texto.
    ##
    ## ## Memoria
    ## Copia propia; los strings de la petición no se pueden banir.
    weave body_text into string:
        var request as ref to transport.Request is self->request
        return calling request.body_text

    ## Cuerpo de la petición interpretado como JSON.
    ##
    ## ## Retorno
    ## El valor JSON (propio) o el error del parser. Un cuerpo vacío es un
    ## `JsonError` de tipo `UnexpectedEof`.
    weave body_json into result of json.JsonValue to json.JsonError:
        var request as ref to transport.Request is self->request
        return calling json.parse with (calling request.body_text)

    ## Cuerpo `application/x-www-form-urlencoded` como pares.
    ##
    ## ## Memoria
    ## Devuelve un valor propio; libéralo con `portus.query.free_query`.
    weave body_form into query_module.Query:
        var request as ref to transport.Request is self->request
        return calling query_module.parse_query with (calling request.body_text)

    ## Cuerpo `multipart/form-data` como partes.
    ##
    ## ## Memoria
    ## Devuelve partes propias; libéralas con `multipart.free_parts`.
    weave body_multipart into maybe list of multipart_module.Part:
        let content_type as maybe string is calling self.header with "content-type"
        if not content_type.is_present:
            return maybe none
        var kind as string is content_type.value
        defer banish kind
        if not calling kind.starts_with with "multipart/form-data":
            return maybe none
        var raw as string is calling self.body_text
        defer banish raw
        return calling multipart_module.parse with kind, raw

    ## Valor de una cookie de la petición.
    ##
    ## ## Retorno
    ## Copia propia, o `none` si no vino.
    weave cookie with name as string into maybe string:
        var raw as maybe string is calling self.header with "Cookie"
        if v as string is raw:
            var cookies as cookie_module.Cookies is calling cookie_module.parse_cookies with v
            var found as maybe string is calling cookie_module.cookie_get with cookies, name
            calling cookie_module.free_cookies with cookies
            return found
        return maybe none

    ## Añade una cookie a la respuesta con `SESSION_OPTIONS`.
    ##
    ## ## Memoria
    ## El valor se copia en la respuesta.
    weave set_cookie with name as string, value as string into void:
        calling self.set_cookie_with with name, value, cookie_module.SESSION_OPTIONS

    ## Añade una cookie a la respuesta con atributos explícitos.
    weave set_cookie_with with name as string, value as string, options as cookie_module.CookieOptions into void:
        var encoded as string is calling cookie_module.serialize_cookie with name, value, options
        var response as ref to transport.Response is self->response
        calling response.set_header with "Set-Cookie", encoded
        banish encoded

    ## Pide al navegador que borre una cookie.
    weave delete_cookie with name as string into void:
        var encoded as string is calling cookie_module.clear_cookie with name, "/"
        var response as ref to transport.Response is self->response
        calling response.set_header with "Set-Cookie", encoded
        banish encoded

    ## Responde con un valor JSON y `Content-Type: application/json`.
    ##
    ## ## Memoria
    ## El texto serializado se copia en la respuesta y se libera aquí.
    weave send_json with value as json.JsonValue into void:
        var encoded as string is calling json.stringify with value
        var response as ref to transport.Response is self->response
        calling response.set_status with 200
        calling response.set_header with "Content-Type", "application/json; charset=utf-8"
        calling response.write_text with encoded
        calling response.mark_sent
        banish encoded
