## Carrito en una cookie (firmada por el navegador: solo demostración).

import portus

const PORT as int is 3000

weave cart with context as ref to portus.Context into result of void to portus.HttpError:
    let current as maybe string is calling context.cookie with "cart"
    var items as string is current or else ""
    let item as maybe string is calling context.query_param with "add"
    if added as string is item:
        if items == "":
            set items is added
        else:
            set items is "{items},{added}"
    calling context.set_cookie with "cart", items
    calling context.send_text with "carrito: {items}"
    return calling portus.ok_void

weave main into int:
    var app as portus.Application is calling portus.new_application
    let r1 as result of void to portus.PatternError is calling portus.get with sigil of app, "/cart", cart
    let served as result of int to string is calling portus.serve with sigil of app, PORT
    return served or else 1
