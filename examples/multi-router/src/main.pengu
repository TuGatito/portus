## Varios grupos de rutas en una sola aplicación, como `multi-router` de Express.
import std.spark
import portus

weave home with context as ref to portus.Context into result of void to portus.HttpError:
    calling context.send_text with "inicio"
    return calling portus.ok_void

weave api_users with context as ref to portus.Context into result of void to portus.HttpError:
    calling context.send_text with "api: usuarios"
    return calling portus.ok_void

weave admin_users with context as ref to portus.Context into result of void to portus.HttpError:
    calling context.send_text with "admin: usuarios"
    return calling portus.ok_void

weave main into int:
    var app as portus.Application is calling portus.new_application
    let root as result of void to portus.PatternError is calling portus.get with sigil of app, "/", home
    var api as portus.Group is calling portus.new_group with sigil of app, "/api"
    let au as result of void to portus.PatternError is calling api.get with "/users", api_users
    var admin as portus.Group is calling portus.new_group with sigil of app, "/admin"
    let du as result of void to portus.PatternError is calling admin.get with "/users", admin_users
    calling spark.println with "portus escuchando en http://127.0.0.1:3000"
    let served as result of int to string is calling portus.serve with sigil of app, 3000
    let bound as int is served or:
        return 1
    return 0
